{
    "name": "magyaranimetweaks",
    "displayName": "MagyarAnimeTweaks",
    "version": "0.1.10.4",
    "packageManager": "pnpm@12.14.0",
    "author": "TTK987",
    "description": "Továbbfejlesztett funkciók és eszközök a MagyarAnime weboldalhoz, amelyek javítják a felhasználói élményt.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.16.0",
        "pnpm": ">=12.0.0"
    },
    "scripts": {
        "build": "tsc && vite build --config vite.config.chrome.ts",
        "build:firefox": "tsc && vite build --config vite.config.firefox.ts",
        "clean:package": "node ./scripts/clean-package.js",
        "package": "pnpm run package:all",
        "package:all": "pnpm run clean:package && pnpm run zip:chrome && pnpm run zip:firefox",
        "zip": "pnpm run build && node ./scripts/zip.js",
        "zip:chrome": "pnpm run build && node ./scripts/zip.js chrome",
        "zip:firefox": "pnpm run build:firefox && node ./scripts/zip.js firefox"
    },
    "dependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@heroui/theme": "^2.4.26",
        "@radix-ui/react-alert-dialog": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-query": "^5.104.3",
        "autoprefixer": "^10.6.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fuse.js": "^7.5.0",
        "hls.js": "^1.7.3",
        "lucide-react": "^0.575.0",
        "plyr": "^3.8.5",
        "postcss": "^8.5.30",
        "react": "^19.3.1",
        "react-color": "^2.19.3",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "vite-plugin-web-extension": "^4.5.1",
        "webextension-polyfill": "^0.12.0"
    },
    "devDependencies": {
        "@rollup/plugin-terser": "^0.4.4",
        "@types/chrome": "^0.1.43",
        "@types/react": "^19.3.0",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^19.3.0",
        "@types/webextension-polyfill": "^0.12.6",
        "@vitejs/plugin-react": "^5.2.0",
        "gulp": "^5.0.1",
        "gulp-zip": "^6.1.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vite": "^7.3.6"
    }
}
