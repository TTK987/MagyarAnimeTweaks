{
    "name": "magyaranimetweaks",
    "displayName": "MagyarAnimeTweaks",
    "version": "0.1.10.2",
    "packageManager": "pnpm@12.0.0+sha512.9e2e3dc3911995868dc94b8175c217c27e95408fa03b4a22749778f2b34f773b77cdd3b39ede8171b22fcd53be6a35342e9fac9948a68ef58df6488ce89a7e67",
    "author": "TTK987",
    "description": "Továbbfejlesztett funkciók és eszközök a MagyarAnime weboldalhoz, amelyek javítják a felhasználói élményt.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.16.0",
        "pnpm": ">=12.0.0"
    },
    "scripts": {
        "build": "tsc && vite build --config vite.config.chrome.ts",
        "build:firefox": "tsc && vite build --config vite.config.firefox.ts",
        "clean:package": "node ./scripts/clean-package.js",
        "package": "pnpm run package:all",
        "package:all": "pnpm run clean:package && pnpm run zip:chrome && pnpm run zip:firefox",
        "zip": "pnpm run build && node ./scripts/zip.js",
        "zip:chrome": "pnpm run build && node ./scripts/zip.js chrome",
        "zip:firefox": "pnpm run build:firefox && node ./scripts/zip.js firefox"
    },
    "dependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@heroui/theme": "^2.4.26",
        "@radix-ui/react-alert-dialog": "^1.1.23",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-query": "^5.102.5",
        "autoprefixer": "^10.5.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fuse.js": "^7.5.0",
        "hls.js": "^1.7.1",
        "lucide-react": "^0.575.0",
        "plyr": "^3.8.4",
        "postcss": "^8.5.26",
        "react": "^19.2.8",
        "react-color": "^2.19.3",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "vite-plugin-web-extension": "^4.5.1",
        "webextension-polyfill": "^0.12.0"
    },
    "devDependencies": {
        "@rollup/plugin-terser": "^0.4.4",
        "@types/chrome": "^0.1.43",
        "@types/react": "^19.2.18",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^19.2.5",
        "@types/webextension-polyfill": "^0.12.5",
        "@vitejs/plugin-react": "^5.2.0",
        "gulp": "^5.0.1",
        "gulp-zip": "^6.1.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vite": "^7.3.6"
    }
}
